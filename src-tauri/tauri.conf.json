{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vFinder",
  "version": "1.0.0",
  "identifier": "com.vfinder.filemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "vFinder",
        "width": 1160,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#1e1e22",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "/*",
          "/**/*",
          "$HOME/**",
          "$CACHE/**",
          "$TEMP/**",
          "/home/**",
          "/run/media/**",
          "/media/**",
          "/mnt/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
